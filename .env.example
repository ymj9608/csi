# Run python3 scripts/init_env.py to generate real local secrets; never commit .env.
DATABASE_PASSWORD=
CSI_INTEGRATION_SECRET=
CSI_INTERNAL_TOKEN=
CSI_ADMIN_USERNAME=reviewer
CSI_ADMIN_PASSWORD=
CSI_REPOSITORY_ALLOWLIST=local/csi-demo
LLM_MODE=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Local coding worker is separate from the read-only review Agent.
CSI_CODING_ENABLED=false
CSI_CODING_REPOSITORIES=ymj9608/Lichu
# VLM: openai or ollama. New project registration requires an architecture image.
# Selecting that image for coding is separate; without a selection use code + policy evidence.
# Code generation in the service stays local; the fast benchmark uses OpenAI separately.
# These credentials are read by the native Python coding worker, never by the browser.
CSI_VLM_PROVIDER=openai
# Empty chooses gpt-5.4-mini-2026-03-17 (openai) or qwen3-vl:8b (ollama).
CSI_VLM_MODEL=
# Native Ollama workers: same settings on Windows and macOS (seconds).
# Limits are upper bounds, not a fixed wait. Backend lease: 2700s; orchestration: 2100s.
CSI_LOCAL_VLM_TIMEOUT_SECONDS=600
CSI_LOCAL_VLM_NUM_CTX=16384
CSI_LOCAL_VLM_NUM_PREDICT=1024
CSI_LOCAL_VLM_KEEP_ALIVE_SECONDS=300
CSI_ARCHITECTURE_TIMEOUT_SECONDS=900
# Backend deadline for abandoned uploaded-diagram jobs; allow model timeout + transfer time.
CSI_ARCHITECTURE_JOB_TIMEOUT_SECONDS=2100
CSI_ARCHITECTURE_NUM_PREDICT=1536
OPENAI_API_KEY=
# Optional local vision worker; uploaded architecture is advisory context only.
# 아래 모델은 별도 구조 JSON 추출 Worker용입니다. 코딩 총괄 제공자는 CSI_VLM_PROVIDER로 선택합니다.
CSI_ARCHITECTURE_MODEL=ministral-3:8b-instruct-2512-q4_K_M
CSI_ARCHITECTURE_PROMPT_VERSION=architecture-v1

# Optional Slack bot: python -m slack_bot.main (separate process).
SLACK_MODE=socket
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ADMIN_USER_IDS=
SLACK_POLL_INTERVAL_SECONDS=5
SLACK_INTERACTIONS_HOST=127.0.0.1
SLACK_INTERACTIONS_PORT=8787
# CSI_BACKEND_URL defaults to http://127.0.0.1:8080 for the native bot.
CSI_FRONTEND_URL=http://127.0.0.1:5174
# Optional durable per-recipient receipts; default .runtime/slack-deliveries.sqlite3.
# SLACK_STATE_PATH=

# Optional local automation: operator-prepared profiles only; paths in the JSON
# are relative to that config file. Start with python -m scripts.start_local_automation.
# CSI_LOCAL_AUTOMATION_CONFIG=.runtime/local-automation.json
